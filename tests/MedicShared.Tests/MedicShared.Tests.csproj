<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <!-- For the logging the shared code does, and the Jellyfin types the shared test helpers use. -->
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The code Medic Picks and Medic Profiles share, compiled in here as it is into each plugin. -->
    <Compile Include="../../shared/Medic.Shared/*.cs" LinkBase="Medic.Shared" />
    <!-- Test helpers shared with the plugins' test projects. -->
    <Compile Include="../Shared/*.cs" LinkBase="Shared" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Medic.Shared" />
    <Using Include="Medic.TestSupport" />
  </ItemGroup>
</Project>
